# ============================================================================
# GOLD SIGNALS - PLANTILLA DE VARIABLES DE ENTORNO
# Copia este archivo a .env (fuera del control de versiones) y rellena los valores.
# NUNCA subas tu archivo .env ni archivos *.session al repositorio Git.
# ============================================================================

# --- Modo de la Aplicación ---
# Rutas servidas bajo /gold (ej. https://desarrollaunbyte.com/gold/)
APP_BASE_PATH=/gold
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8010

# --- Base de Datos ---
# Ruta fuera del repo en producción (ej. sqlite:////var/lib/gold-signals/gold.db)
DATABASE_URL=sqlite:///./data/gold_signals.db

# --- Autenticación del Tablero Web ---
# Usuario y contraseña para proteger el acceso a /gold/
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Secreto aleatorio de al menos 32 caracteres para firmar sesiones JWT
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440

# --- Telegram MTProto (Telethon - Modo Solo Lectura) ---
# Obtén API_ID y API_HASH en https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
# Ruta absoluta o relativa a la carpeta secrets/ (ignorada en git) para el archivo .session
TELEGRAM_SESSION_PATH=./secrets/telegram_gold
# Lista de canales separados por coma (sin @ o con @)
TELEGRAM_CHANNELS=tagsignals
# Límite inicial de mensajes históricos a leer al arrancar
TELEGRAM_INITIAL_LIMIT=100

# --- Evaluador de Precios (XAUUSD / GC) ---
# Intervalo en segundos para evaluar señales pendientes contra precios reales
EVALUATOR_INTERVAL_SECONDS=300
# Horas máximas antes de marcar una señal límite no activada como expirada
SIGNAL_EXPIRY_HOURS=48
# Símbolo principal en Yahoo Finance (GC=F futuros de oro / XAUUSD=X spot)
PRICE_PRIMARY_TICKER=GC=F
PRICE_FALLBACK_TICKER=XAUUSD=X
